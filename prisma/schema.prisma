
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Paciente {
  id Int @id @default(autoincrement())
  nome String
  cpf String @unique
  telefone String
  email String @unique
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pacientes")
}
